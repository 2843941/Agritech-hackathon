# Copy this file to backend/.env and fill in real values.
#
# NEVER commit backend/.env — it is gitignored.
# Get the real values from whoever owns Track A, shared over a private channel only
# (Signal, WhatsApp DM, Bitwarden Send — not the group chat, not GitHub).

# --- Google Gemini (photo analysis + chat adviser) ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Supabase (database) ---
# The anon key is safe-ish for a public client. The service key bypasses
# all row-level security — treat it like a root password. Never ship it
# to a browser. Only used server-side in backend/db.py.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here